<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/site.css">
    <title>Owen Espitia's Portfolio</title>
</head>
<body>
    <%- include("partials/header.ejs") %>
    <div class="slideshow-container">
        <div class="slide">
            <img id = "slide-img" src="/images/meAndMikka.jpg" alt="Me and a Funny Puppy" width="200" height="250">
        </div>
    </div>

    <main id = "main-content" role="main">
        <div class = "container">
            <section id="about" aria-labelledby="about-heading">
                <h2 id = "about-heading">Bio</h2>
                <div class="about-content">
                    <p style="text-indent: 1rem;">My name is <strong>Owen Espitia</strong>. I grew up in California but moved to Utah a long time ago. I am very passionate about computer science and one day hope to make a career out of Data Analytics and Machine Learning Models</p>
                    
                </div>

            </section>
        </div>

    </main>
    <%- include("partials/footer.ejs") %>

<script>
        const images = [
            "/images/meAndMikka.jpg",
            "/images/meAndFellas.jpg",
            "/images/meAndBurgess.jpg",
            "/images/meAndUSG.jpg"
        ];

        let index = 0;
        const imgAtHand = document.getElementById("slide-img");

        setInterval(() => {
        index = (index + 1) % images.length;
        imgAtHand.src = images[index];
        }, 3000);
    </script>

</body>
</html>